[Unit]
Description=Prism egress server (Singapore)
After=network-online.target
Wants=network-online.target

[Service]
# Needs CAP_NET_BIND_SERVICE to bind :443, or run behind a port-forward.
ExecStart=/usr/local/bin/prism-server -c /etc/prism/server.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3
# Harden: run as a dedicated user, read-only fs except config.
DynamicUser=yes
StateDirectory=prism
ConfigurationDirectory=prism
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
