[Unit]
Description=Prism egress server
Documentation=https://github.com/Gloridust/prism/blob/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
# One-time setup (see docs/DEPLOY.md):
#   useradd --system --no-create-home --shell /usr/sbin/nologin prism
#   install -d -o root -g prism -m 0750 /etc/prism
#   install -o root -g prism -m 0640 server.json /etc/prism/server.json
User=prism
Group=prism
ExecStartPre=/usr/local/bin/prism-server -c /etc/prism/server.json -check
ExecStart=/usr/local/bin/prism-server -c /etc/prism/server.json
# SIGHUP re-reads credentials and quotas without dropping other clients.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=65536

# /var/lib/prism: ACME certificate cache and the credentials file.
StateDirectory=prism
StateDirectoryMode=0700

# Bind :443 without root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
