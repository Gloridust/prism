#!/bin/sh /etc/rc.common
# OpenWrt procd init script for prism-client (router mode).
# Install:
#   cp prism-client /usr/bin/ && chmod +x /usr/bin/prism-client
#   cp client-router.json /etc/prism/client.json
#   cp scripts/openwrt-prism-client.init /etc/init.d/prism-client
#   chmod +x /etc/init.d/prism-client
#   /etc/init.d/prism-client enable && /etc/init.d/prism-client start

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/prism-client
CONF=/etc/prism/client.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
